{
  "name": "ma-moulinette",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "deploy:app": "npm run build && npx wrangler deploy -c wrangler.app.toml",
    "test": "vitest run",
    "assets": "node tools/assets/build.ts",
    "map": "node tools/map/build.mjs",
    "logs:serve": "node tools/log-server.ts",
    "dev:api": "wrangler dev -c wrangler.app.toml --port 8787",
    "bots": "node --experimental-transform-types --no-warnings --import ./tools/ts-resolve.mjs tools/net/bots.ts",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "budget": "node tools/ci/bundle-budget.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.186.0",
    "@types/web-bluetooth": "^0.0.21",
    "meshoptimizer": "^1.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/core": "^8.6.2",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@garmin/fitsdk": "^21.218.0",
    "three": "^0.186.1"
  }
}
